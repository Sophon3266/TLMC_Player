<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notificationArtwork"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="封面"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notificationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notificationArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/notificationProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="@color/notification_progress_background"
        android:progressTint="@color/notification_progress_tint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notificationPrev"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="上一首"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_previous"
            android:tint="@color/notification_icon_tint" />

        <ImageButton
            android:id="@+id/notificationPlayPause"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="播放或暂停"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play"
            android:tint="@color/notification_icon_tint" />

        <ImageButton
            android:id="@+id/notificationNext"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="下一首"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_next"
            android:tint="@color/notification_icon_tint" />

        <ImageButton
            android:id="@+id/notificationOrder"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="播放顺序"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sequential"
            android:tint="@color/notification_icon_tint" />

    </LinearLayout>

</LinearLayout>
